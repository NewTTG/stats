# Copier en .env (non versionné) et compléter.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base applicative (gérée par Django). Vide => SQLite local pour le dev.
APP_DB_HOST=
APP_DB_PORT=5432
APP_DB_NAME=stats_app
APP_DB_USER=stats_app
APP_DB_PASSWORD=

# Base KPI source (lecture seule, compte dédié)
KPI_DB_HOST=
KPI_DB_PORT=5432
KPI_DB_NAME=
KPI_DB_SCHEMA=
KPI_DB_USER=
KPI_DB_PASSWORD=
# Sans KPI_DB_HOST : base de démonstration (python manage.py charger_demo_kpi).
# Défaut : data/kpi_demo.sqlite3
KPI_DEMO_SQLITE=

# Cache de résultats commun aux utilisateurs ayant le même périmètre effectif.
KPI_CACHE_ENABLED=1
KPI_CACHE_TTL=300
KPI_CACHE_MAX_MB=512
KPI_CACHE_ITEM_MAX_MB=32
# Même disque local pour les processus web et rapports ; ne pas exposer sur le web.
KPI_CACHE_DIR=
KPI_CACHE_WAIT_SECONDS=65

# Rapports : modèle PowerPoint (facultatif, défaut config/modele_rapport.pptx s'il existe)
PPTX_MODELE=
# Référentiel rechargé depuis l'administration (défaut : OPT_Network_Database_V2.xlsx à la racine)
REFERENTIEL_XLSX=
# Fond de carte des événements (défaut : OpenStreetMap). Vide = pas de fond (réseau sans Internet).
CARTE_TUILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Durée des requêtes dans la console : avertissement au-delà de N secondes (défaut 10)
REQUETE_LENTE_S=10
# 1 = rapports générés immédiatement, sans worker (dev). Sinon : python manage.py qcluster
Q_SYNC=0

# Recherche IA (facultatif) : clé de l'API Groq. Vide = case « Recherche IA » masquée,
# interprétation par règles locales uniquement. Ne jamais versionner de clé.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=10

# Accès sans compte : une session « visiteur » par navigateur (0 : connexion obligatoire)
ACCES_ANONYME=1
