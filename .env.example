# Copier en .env (non versionné) et compléter.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base applicative (gérée par Django). Vide => SQLite local pour le dev.
APP_DB_HOST=
APP_DB_PORT=5432
APP_DB_NAME=stats_app
APP_DB_USER=stats_app
APP_DB_PASSWORD=

# Base KPI source (lecture seule, compte dédié)
KPI_DB_HOST=
KPI_DB_PORT=5432
KPI_DB_NAME=
KPI_DB_SCHEMA=
KPI_DB_USER=
KPI_DB_PASSWORD=
